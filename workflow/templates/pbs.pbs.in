#!/usr/bin/env bash
#PBS -A {{ACCOUNT}}
#PBS -q {{PARTITION}}
#PBS -N {{JOB_NAME}}
#PBS -l select={{NODES}}:ncpus={{CPUS_PER_TASK}}:ngpus={{GPUS}}
#PBS -l walltime={{WALLTIME}}
#PBS -o {{RUN_DIR}}/pbs_stdout.log
#PBS -e {{RUN_DIR}}/pbs_stderr.log

set -euo pipefail

REPO_ROOT="{{REPO_ROOT}}"
RUN_DIR="{{RUN_DIR}}"

cd "$REPO_ROOT"

# Optionally run steps depending on RUN_COMPILE/RUN_RUN/RUN_ANALYZE (1=yes,0=no)
RUN_COMPILE={{RUN_COMPILE}}
RUN_RUN={{RUN_RUN}}
RUN_ANALYZE={{RUN_ANALYZE}}

if [[ "$RUN_COMPILE" -eq 1 ]]; then
	./workflow/bin/compile.sh "$RUN_DIR"
else
	echo "Skipping compile (RUN_COMPILE=0)"
fi

if [[ "$RUN_RUN" -eq 1 ]]; then
	./workflow/bin/run.sh "$RUN_DIR"
else
	echo "Skipping run (RUN_RUN=0)"
fi

if [[ "$RUN_ANALYZE" -eq 1 ]]; then
	./workflow/bin/analyze.sh "$RUN_DIR"
else
	echo "Skipping analyze (RUN_ANALYZE=0)"
fi
