#!/bin/bash
# Generated SLURM job script (do not edit directly)

#SBATCH --job-name={{JOB_NAME}}
#SBATCH --account={{ACCOUNT}}
#SBATCH --partition={{PARTITION}}
#SBATCH --nodes={{NODES}}
#SBATCH --ntasks={{NTASKS}}
#SBATCH --ntasks-per-node={{NTASKS}}
#SBATCH --cpus-per-task={{CPUS_PER_TASK}}
#SBATCH --gres=gpu:{{GPUS}}
#SBATCH --time={{WALLTIME}}
#SBATCH --output={{LOG_OUT}}
#SBATCH --error={{LOG_ERR}}

set -euo pipefail

ABYSS_ROOT="{{ABYSS_ROOT}}"
RUN_DIR="{{RUN_DIR}}"

mkdir -p "$RUN_DIR"

export OMPI_MCA_btl_vader_backing_directory="{{OMPI_BACKING_DIR}}"
export OMPI_MCA_osc_sm_backing_directory="{{OMPI_BACKING_DIR}}"
export OMPI_MCA_shmem_mmap_backing_file_base_dir="{{OMPI_BACKING_DIR}}"

cd "$ABYSS_ROOT"

echo "[job] host=$(hostname) start=$(date)"
echo "[job] run_dir=$RUN_DIR"

# Compile
bash workflow/bin/compile.sh "$RUN_DIR"

# Run
bash workflow/bin/run.sh "$RUN_DIR"

# Analyze
bash workflow/bin/analyze.sh "$RUN_DIR"

echo "[job] done=$(date)"
