#!/usr/bin/env bash
#SBATCH --account={{ACCOUNT}}
#SBATCH --partition={{MCLUSTER_PARTITION}}
#SBATCH --job-name={{JOB_NAME}}
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task={{MCLUSTER_CPUS}}
#SBATCH --mem={{MCLUSTER_MEM}}
#SBATCH --time={{MCLUSTER_WALLTIME}}
#SBATCH --output={{RUN_DIR}}/mcluster_stdout.log
#SBATCH --error={{RUN_DIR}}/mcluster_stderr.log

set -euo pipefail

REPO_ROOT="{{REPO_ROOT}}"
RUN_DIR="{{RUN_DIR}}"

cd "$REPO_ROOT"

# Set OpenMP threads to use all allocated CPUs
export OMP_NUM_THREADS={{MCLUSTER_CPUS}}

echo "McLuster IC generation job starting"
echo "OMP_NUM_THREADS=$OMP_NUM_THREADS"
echo ""

# Run compile step (builds both ABYSS and McLuster)
RUN_COMPILE={{RUN_COMPILE}}
if [[ "$RUN_COMPILE" -eq 1 ]]; then
	./workflow/bin/compile.sh "$RUN_DIR"
else
	echo "Skipping compile (RUN_COMPILE=0)"
fi

# Run McLuster IC generation
./workflow/bin/run_mcluster.sh "$RUN_DIR"

echo ""
echo "McLuster IC generation complete"
